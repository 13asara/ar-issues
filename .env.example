APP_NAME="AR Issues"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow
APP_URL=https://ar.example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ar_issues
DB_USERNAME=ar_issues
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
CACHE_STORE=file

ADMIN_PASSWORD=change-me-now
MIND_COMPILE_TOKEN=long-random-string-shared-with-node
MIND_COMPILE_TIMEOUT=900
